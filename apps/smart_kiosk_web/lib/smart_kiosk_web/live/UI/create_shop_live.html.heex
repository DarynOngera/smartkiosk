<Layouts.app
  flash={@flash}
  current_path="/create-shop"
  current_user={@current_user}
  cart_count={@cart_count}
>
  <div class="min-h-screen bg-[#0B0F1A] text-white p-6 md:py-16">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-3xl font-bold mb-2 text-center">Create Your Shop</h1>
      <p class="text-slate-400 text-center mb-10">
        Fill in the details below to launch your digital storefront.
      </p>

      <div class="bg-white/5 border border-white/10 rounded-3xl p-8 backdrop-blur-xl shadow-2xl">
        <.form for={@form} phx-submit="save" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-1.5">
              <label class="text-sm font-medium text-slate-300">Shop Name</label>
              <input
                type="text"
                name="shop[name]"
                value={@form[:name].value}
                placeholder="My Amazing Shop"
                class="w-full bg-[#131825] border border-white/10 text-white rounded-xl p-4 focus:bg-[#1A2234] focus:border-violet-500/50 focus:ring-2 focus:ring-violet-500/20 transition-all"
              />
            </div>
            <div class="space-y-1.5">
              <label class="text-sm font-medium text-slate-300">Phone Number</label>
              <input
                type="tel"
                name="shop[phone]"
                value={@form[:phone].value}
                placeholder="+254 7XX XXX XXX"
                class="w-full bg-[#131825] border border-white/10 text-white rounded-xl p-4 focus:bg-[#1A2234] focus:border-violet-500/50 focus:ring-2 focus:ring-violet-500/20 transition-all"
              />
            </div>
            <div class="space-y-1.5">
              <label class="text-sm font-medium text-slate-300">Email Address</label>
              <input
                type="email"
                name="shop[email]"
                value={@form[:email].value}
                placeholder="hello@shop.com"
                class="w-full bg-[#131825] border border-white/10 text-white rounded-xl p-4 focus:bg-[#1A2234] focus:border-violet-500/50 focus:ring-2 focus:ring-violet-500/20 transition-all"
              />
            </div>
            <div class="space-y-1.5">
              <label class="text-sm font-medium text-slate-300">City</label>
              <input
                type="text"
                name="shop[city]"
                value={@form[:city].value}
                placeholder="Nairobi"
                class="w-full bg-[#131825] border border-white/10 text-white rounded-xl p-4 focus:bg-[#1A2234] focus:border-violet-500/50 focus:ring-2 focus:ring-violet-500/20 transition-all"
              />
            </div>
            <div class="space-y-1.5">
              <label class="text-sm font-medium text-slate-300">Country</label>
              <input
                type="text"
                name="shop[country]"
                value={@form[:country].value}
                placeholder="Kenya"
                class="w-full bg-[#131825] border border-white/10 text-white rounded-xl p-4 focus:bg-[#1A2234] focus:border-violet-500/50 focus:ring-2 focus:ring-violet-500/20 transition-all"
              />
            </div>
            <div class="space-y-1.5">
              <label class="text-sm font-medium text-slate-300">Address</label>
              <input
                type="text"
                id="shop_address"
                name="shop[address]"
                value={@form[:address].value}
                placeholder="Tom Mboya Street"
                class="w-full bg-[#131825] border border-white/10 text-white rounded-xl p-4 focus:bg-[#1A2234] focus:border-violet-500/50 focus:ring-2 focus:ring-violet-500/20 transition-all"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label class="text-sm font-medium text-slate-300">Choose Plan</label>
            <select
              name="shop[plan]"
              class="w-full bg-[#131825] border border-white/10 text-white rounded-xl p-4 focus:bg-[#1A2234] focus:border-violet-500/50 focus:ring-2 focus:ring-violet-500/20 transition-all"
            >
              <%= for {label, value} <- @plans do %>
                <option value={value} selected={@form[:plan].value == value}>
                  <%= label %>
                </option>
              <% end %>
            </select>
          </div>
          <div class="space-y-1.5">
            <label class="text-sm font-medium text-slate-300">Category</label>
            <select
              name="shop[category]"
              class="w-full bg-[#131825] border border-white/10 text-white rounded-xl p-4 focus:bg-[#1A2234] focus:border-violet-500/50 focus:ring-2 focus:ring-violet-500/20 transition-all"
            >
              <%= for {label, value} <- @categories do %>
                <option value={value} selected={@form[:category].value == value}>
                  <%= label %>
                </option>
              <% end %>
            </select>
          </div>
          <div class="space-y-1.5">
            <label class="text-sm font-medium text-slate-300">Description</label>
            <textarea
              name="shop[description]"
              placeholder="Tell customers about your shop..."
              class="w-full bg-[#131825] border border-white/10 text-white rounded-xl p-4 focus:bg-[#1A2234] focus:border-violet-500/50 focus:ring-2 focus:ring-violet-500/20 transition-all"
            ><%= @form[:description].value %></textarea>
          </div>

          <div class="space-y-2">
            <label class="text-sm font-medium text-slate-300">Shop Location</label>
            <p class="text-xs text-slate-500">Click on the map to set your shop's location</p>
            <div
              id="shop-location-map"
              phx-hook="ShopLocationMap"
              data-lat-input-id="shop_lat"
              data-lng-input-id="shop_lng"
              data-address-input-id="shop_address"
              class="h-64 rounded-xl border border-white/10 bg-[#131825]"
            >
            </div>
            <input type="hidden" id="shop_lat" name="shop[lat]" value={@form[:lat].value} />
            <input type="hidden" id="shop_lng" name="shop[lng]" value={@form[:lng].value} />
          </div>

          <button
            type="submit"
            class="w-full py-4 bg-violet-600 hover:bg-violet-500 text-white rounded-xl font-bold text-lg transition-all shadow-lg shadow-violet-600/20 hover:scale-[1.01] active:scale-[0.98]"
          >
            Create Shop
          </button>
        </.form>
      </div>
    </div>
  </div>

  <%!-- Include Leaflet via CDN for the shop location map --%>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
  </script>
</Layouts.app>
