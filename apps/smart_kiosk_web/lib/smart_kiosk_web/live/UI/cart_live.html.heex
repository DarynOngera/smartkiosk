<div class="min-h-screen bg-[#0B0F1A] text-white">
  <.navbar current_user={@current_user} cart_count={@cart_count} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <%= if @show_receipt && @order do %>
      <div
        id="receipt-container"
        phx-hook="PrintReceipt"
        class="digital-receipt bg-white text-black rounded-lg p-4 max-w-sm mx-auto font-mono mb-6"
      >
        <div class="text-sm mb-2">
          <div class="font-semibold"><%= (@order.shop && @order.shop.name) || "Shop" %></div>
          <div><%= DateTime.utc_now() |> DateTime.to_string() %></div>
          <div>Order: <%= String.slice(@order.id, 0, 8) %></div>
        </div>

        <div class="divide-y">
          <%= for item <- @order.items do %>
            <div class="flex justify-between text-sm py-1">
              <span><%= item.product_name %> x<%= item.quantity %></span>
              <span>KES <%= item.line_total %></span>
            </div>
          <% end %>
        </div>

        <div class="flex justify-between font-bold mt-4">
          <span>Total</span>
          <span>KES <%= @order.total %></span>
        </div>

        <%= if @order.delivery do %>
          <div class="mt-4 rounded-lg border border-slate-200 p-3 text-sm">
            <div class="font-semibold mb-2">Delivery Tracking</div>
            <div class="flex justify-between">
              <span class="text-slate-600">Status</span>
              <span><%= String.capitalize(to_string(@order.delivery.status)) %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-600">Rider</span>
              <span>
                <%= if @order.delivery.rider_id,
                  do: String.slice(@order.delivery.rider_id, 0, 8),
                  else: "Pending" %>
              </span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-600">Live Location</span>
              <span>
                <%= if @rider_location do %>
                  <%= @rider_location.lat %>, <%= @rider_location.lng %>
                <% else %>
                  Waiting for rider updates
                <% end %>
              </span>
            </div>
          </div>
        <% end %>

        <%= if @order.transactions != [] && Enum.any?(@order.transactions, &(&1.payment_method == :cash)) do %>
          <% cash_txn = Enum.find(@order.transactions, &(&1.payment_method == :cash)) %>
          <div class="flex justify-between text-sm mt-1 text-slate-600">
            <span>Received</span>
            <span>KES <%= cash_txn.metadata["received"] || @order.total %></span>
          </div>
          <div class="flex justify-between text-sm font-semibold mt-1">
            <span>Change</span>
            <span>KES <%= cash_txn.metadata["change"] || 0.0 %></span>
          </div>
        <% end %>

        <div class="text-sm mt-3">Thank you for your purchase!</div>

        <div class="flex gap-2 mt-4">
          <button phx-click="print_receipt" phx-value-order-id={@order.id} class="btn no-print">
            Print Receipt
          </button>
          <button phx-click="share_receipt" class="btn no-print">Share Receipt</button>
          <button phx-click="new_order" class="btn no-print">New Order</button>
        </div>
      </div>
    <% end %>
    <% items_by_shop = Enum.group_by(@cart_items, fn item -> item.product.shop end) %>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <%!-- ── Cart items ─────────────────────────────────────────────────── --%>
      <div class="lg:col-span-2">
        <h1 class="text-3xl font-bold mb-8">
          Shopping Cart
          <span class="text-lg font-normal text-slate-500 ml-2">
            (<%= @cart_count %> <%= if @cart_count == 1, do: "item", else: "items" %>)
          </span>
        </h1>

        <%= if @cart_items == [] do %>
          <%!-- Empty state --%>
          <div class="bg-white/5 border border-white/10 rounded-3xl p-12 text-center">
            <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-6">
              <.icon name="hero-shopping-cart" class="w-10 h-10 text-slate-600" />
            </div>
            <h2 class="text-xl font-semibold text-white mb-2">Your cart is empty</h2>
            <p class="text-slate-500 mb-6">Start shopping to add items to your cart</p>
            <.link
              navigate="/"
              class="inline-flex items-center gap-2 px-6 py-3 bg-violet-500 hover:bg-violet-400 text-white rounded-xl font-semibold transition-all"
            >
              <.icon name="hero-arrow-left" class="w-5 h-5" /> Browse Shops
            </.link>
          </div>
        <% else %>
          <%!-- Group items visually by shop --%>
          <% items_by_shop = Enum.group_by(@cart_items, fn item -> item.product.shop end) %>
          <div class="space-y-6">
            <%= for {shop, items} <- items_by_shop do %>
              <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden">
                <%!-- Shop header --%>
                <div class="px-5 py-3 border-b border-white/10 flex items-center gap-2">
                  <.icon name="hero-storefront" class="w-4 h-4 text-violet-400" />
                  <span class="text-sm font-semibold text-violet-400"><%= shop.name %></span>
                </div>

                <%!-- Items for this shop --%>
                <div class="divide-y divide-white/5">
                  <%= for cart_item <- items do %>
                    <div class="flex items-center gap-4 p-5">
                      <%!-- Thumbnail --%>
                      <div class="w-16 h-16 bg-slate-800 rounded-xl flex items-center justify-center flex-shrink-0 overflow-hidden">
                        <%= if cart_item.product.images != [] do %>
                          <img
                            src={List.first(cart_item.product.images).url}
                            alt={cart_item.product_name}
                            class="w-full h-full object-cover"
                          />
                        <% else %>
                          <.icon name="hero-shopping-bag" class="w-7 h-7 text-slate-600" />
                        <% end %>
                      </div>

                      <%!-- Product info --%>
                      <div class="flex-1 min-w-0">
                        <h3 class="font-semibold text-white truncate">
                          <%= cart_item.product_name %>
                        </h3>
                        <p class="text-violet-400 font-bold mt-0.5">
                          KES <%= cart_item.unit_price %>
                        </p>
                      </div>

                      <%!-- Quantity stepper --%>
                      <div class="flex items-center gap-2">
                        <button
                          phx-click="update_quantity"
                          phx-value-id={cart_item.id}
                          phx-value-quantity={cart_item.quantity - 1}
                          class="w-8 h-8 bg-white/5 hover:bg-white/10 rounded-lg flex items-center justify-center transition-colors"
                          aria-label="Decrease quantity"
                        >
                          <.icon name="hero-minus" class="w-4 h-4" />
                        </button>
                        <input
                          type="number"
                          value={cart_item.quantity}
                          phx-blur="update_quantity"
                          phx-value-id={cart_item.id}
                          name="quantity"
                          class="w-14 h-8 bg-white/5 border border-white/10 rounded-lg text-center font-semibold tabular-nums focus:outline-none focus:border-violet-500 transition-colors"
                        />
                        <button
                          phx-click="update_quantity"
                          phx-value-id={cart_item.id}
                          phx-value-quantity={cart_item.quantity + 1}
                          class="w-8 h-8 bg-white/5 hover:bg-white/10 rounded-lg flex items-center justify-center transition-colors"
                          aria-label="Increase quantity"
                        >
                          <.icon name="hero-plus" class="w-4 h-4" />
                        </button>
                      </div>

                      <%!-- Line total --%>
                      <div class="text-right min-w-[80px]">
                        <p class="font-bold text-white tabular-nums">
                          KES <%= cart_item.line_total %>
                        </p>
                      </div>

                      <%!-- Remove --%>
                      <button
                        phx-click="remove_item"
                        phx-value-id={cart_item.id}
                        class="p-2 text-slate-500 hover:text-red-400 transition-colors"
                        aria-label="Remove item"
                      >
                        <.icon name="hero-x-mark" class="w-5 h-5" />
                      </button>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <%!-- ── Order summary + checkout ──────────────────────────────────── --%>
      <div class="lg:col-span-1">
        <div class="bg-white/5 border border-white/10 rounded-3xl p-6 sticky top-24">
          <h2 class="text-xl font-bold mb-6">Order Summary</h2>

          <%!-- Subtotals per shop --%>
          <%= if @cart_items != [] do %>
            <% items_by_shop = Enum.group_by(@cart_items, fn i -> i.product.shop end) %>
            <div class="space-y-2 mb-4">
              <%= for {shop, items} <- items_by_shop do %>
                <% shop_total = Cart.calculate_cart_total(items) %>
                <div class="flex justify-between text-sm text-slate-400">
                  <span><%= shop.name %></span>
                  <span class="tabular-nums">KES <%= shop_total %></span>
                </div>
              <% end %>
            </div>
            <div class="border-t border-white/10 pt-4 mb-6">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-300">Total</span>
                <span class="text-2xl font-bold text-white tabular-nums">
                  KES <%= @cart_total %>
                </span>
              </div>
            </div>
          <% else %>
            <div class="border-t border-white/10 pt-4 mb-6">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-300">Total</span>
                <span class="text-2xl font-bold text-white">KES 0.00</span>
              </div>
            </div>
          <% end %>

          <%!-- Checkout form — only when cart has items --%>
          <%= if @cart_items != [] do %>
            <.form for={@checkout_form} phx-submit="checkout" id="checkout-form">
              <div class="space-y-4 mb-6">
                <%!-- Full name --%>
                <div class="space-y-1.5">
                  <label class="text-[11px] uppercase tracking-[0.2em] text-slate-400 font-bold">
                    Full Name
                  </label>
                  <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500 group-focus-within:text-violet-400 transition-colors">
                      <.icon name="hero-user" class="w-4 h-4" />
                    </div>
                    <input
                      type="text"
                      name="full_name"
                      value={@checkout_form[:full_name].value}
                      placeholder="Jane Mwangi"
                      required
                      class="w-full bg-slate-900/50 border border-white/5 rounded-xl py-3 pl-10 pr-4 text-white placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500 transition-all text-sm"
                    />
                  </div>
                </div>

                <div class="space-y-1.5">
                  <label class="text-[11px] uppercase tracking-[0.2em] text-slate-400 font-bold">
                    Phone Number
                  </label>
                  <div class="relative group">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500 group-focus-within:text-violet-400 transition-colors">
                      <.icon name="hero-phone" class="w-4 h-4" />
                    </div>
                    <input
                      type="tel"
                      name="phone_number"
                      value={@checkout_form[:phone_number].value}
                      placeholder="+254 7XX XXX XXX"
                      required
                      class="w-full bg-slate-900/50 border border-white/5 rounded-xl py-3 pl-10 pr-4 text-white placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500 transition-all text-sm"
                    />
                  </div>
                </div>

                <div class="space-y-4 pt-2 border-t border-white/10">
                  <div>
                    <p class="text-[11px] uppercase tracking-[0.2em] text-slate-400 font-bold mb-2">
                      Delivery or Pickup
                    </p>
                    <p class="text-xs text-slate-500">
                      Choose delivery to your location or pickup from the shop.
                    </p>
                  </div>

                  <%= for {shop, items} <- items_by_shop do %>
                    <% shop_zones = Map.get(@delivery_zones_by_shop, shop.id, []) %>
                    <div class="rounded-2xl border border-white/10 bg-white/5 p-4 space-y-3">
                      <div class="flex items-center justify-between gap-3">
                        <div>
                          <h3 class="font-semibold text-white"><%= shop.name %></h3>
                          <p class="text-xs text-slate-400"><%= length(items) %> item(s)</p>
                        </div>
                        <span class="text-xs text-slate-500">
                          KES <%= Cart.calculate_cart_total(items) %>
                        </span>
                      </div>

                      <div class="space-y-1.5">
                        <label class="text-[11px] uppercase tracking-[0.2em] text-slate-400 font-bold">
                          Delivery Method
                        </label>
                        <div class="grid grid-cols-2 gap-2">
                          <% stored_delivery_type =
                            get_in(@checkout_params, [:shop_delivery, shop.id, "delivery_type"]) ||
                              "delivery" %>
                          <label class="cursor-pointer">
                            <input
                              type="radio"
                              name={"shop_delivery[#{shop.id}][delivery_type]"}
                              value="delivery"
                              checked={stored_delivery_type == "delivery"}
                              class="peer sr-only"
                            />
                            <div class="rounded-xl border border-white/10 bg-slate-900/50 p-3 text-center peer-checked:border-violet-500 peer-checked:bg-violet-500/10 transition-all">
                              <div class="flex items-center justify-center gap-2">
                                <.icon name="hero-truck" class="w-4 h-4" />
                                <span class="text-sm font-medium">Delivery</span>
                              </div>
                            </div>
                          </label>
                          <label class="cursor-pointer">
                            <input
                              type="radio"
                              name={"shop_delivery[#{shop.id}][delivery_type]"}
                              value="pickup"
                              checked={stored_delivery_type == "pickup"}
                              class="peer sr-only"
                            />
                            <div class="rounded-xl border border-white/10 bg-slate-900/50 p-3 text-center peer-checked:border-violet-500 peer-checked:bg-violet-500/10 transition-all">
                              <div class="flex items-center justify-center gap-2">
                                <.icon name="hero-shopping-bag" class="w-4 h-4" />
                                <span class="text-sm font-medium">Pickup</span>
                              </div>
                            </div>
                          </label>
                        </div>
                      </div>

                      <div class="delivery-fields space-y-3" data-shop-id={shop.id}>
                        <div class="space-y-1.5">
                          <label class="text-[11px] uppercase tracking-[0.2em] text-slate-400 font-bold">
                            Delivery zone
                          </label>
                          <select
                            name={"shop_delivery[#{shop.id}][delivery_zone_id]"}
                            class="w-full bg-slate-900/50 border border-white/5 rounded-xl py-3 px-4 text-white focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500 transition-all text-sm"
                          >
                            <option value="">Choose a zone</option>
                            <%= for zone <- shop_zones do %>
                              <option
                                value={zone.id}
                                selected={
                                  get_in(@checkout_params, [
                                    :shop_delivery,
                                    shop.id,
                                    "delivery_zone_id"
                                  ]) == zone.id
                                }
                              >
                                <%= zone.name %> — KES <%= zone.base_fee %>
                              </option>
                            <% end %>
                          </select>
                          <%= if shop_zones == [] do %>
                            <p class="text-xs text-amber-400">
                              No active delivery zones are available for this shop yet.
                            </p>
                          <% end %>
                        </div>

                        <div class="space-y-1.5">
                          <label class="text-[11px] uppercase tracking-[0.2em] text-slate-400 font-bold">
                            Delivery point / building
                          </label>
                          <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500 group-focus-within:text-violet-400 transition-colors">
                              <.icon name="hero-map-pin" class="w-4 h-4" />
                            </div>
                            <input
                              type="text"
                              name={"shop_delivery[#{shop.id}][delivery_address]"}
                              value={
                                get_in(@checkout_params, [
                                  :shop_delivery,
                                  shop.id,
                                  "delivery_address"
                                ]) || ""
                              }
                              placeholder="Building, estate or landmark"
                              class="w-full bg-slate-900/50 border border-white/5 rounded-xl py-3 pl-10 pr-4 text-white placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-violet-500/50 focus:border-violet-500 transition-all text-sm"
                            />
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>

              <%!-- Submit --%>
              <button
                type="submit"
                disabled={@checking_out}
                class={[
                  "w-full py-4 rounded-xl font-bold text-white text-base transition-all",
                  "flex items-center justify-center gap-2",
                  if(@checking_out,
                    do: "bg-violet-500/50 cursor-not-allowed",
                    else:
                      "bg-violet-500 hover:bg-violet-400 shadow-lg shadow-violet-500/20 active:scale-[0.98]"
                  )
                ]}
              >
                <%= if @checking_out do %>
                  <span class="loading loading-spinner loading-sm"></span> Placing order…
                <% else %>
                  <.icon name="hero-credit-card" class="w-5 h-5" /> Place Order
                <% end %>
              </button>
            </.form>

            <%= if @show_payment_selection do %>
              <div class="mt-6 space-y-3">
                <h3 class="text-sm font-semibold">Complete Payment</h3>
                <p class="text-xs text-slate-400">
                  Choose a payment method to complete your order.
                </p>
                <div class="flex gap-2 mt-2">
                  <button
                    phx-click="start_payment"
                    phx-value-method="mpesa"
                    class="flex-1 py-2 rounded-lg bg-amber-500 text-white"
                  >
                    Pay with M-Pesa
                  </button>
                  <button
                    phx-click="start_payment"
                    phx-value-method="card"
                    class="flex-1 py-2 rounded-lg bg-blue-600 text-white"
                  >
                    Pay with Card
                  </button>
                </div>
                <div class="text-xs text-slate-500">
                  (Payment processing is handled externally; you'll see your receipt once payment is confirmed.)
                </div>
              </div>
            <% end %>

            <p class="text-center mt-3 text-xs text-slate-600">
              By placing your order you agree to our terms of service
            </p>
          <% end %>

          <.link
            navigate="/"
            class="block text-center mt-4 text-violet-400 hover:text-violet-300 font-medium transition-colors text-sm"
          >
            ← Continue Shopping
          </.link>

          <%= if @mpesa_modal_open do %>
            <div class="fixed inset-0 z-[60] flex items-center justify-center">
              <div
                phx-click="close_mpesa_modal"
                class="absolute inset-0 bg-black/60 backdrop-blur-sm"
              >
              </div>

              <div class="relative bg-[#0B0F1A] p-8 rounded-2xl w-full max-w-md border border-white/10 shadow-2xl">
                <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
                  <.icon name="hero-phone" class="w-6 h-6 text-yellow-500" /> M-PESA STK Push
                </h3>

                <%= if @mpesa_pending do %>
                  <div class="space-y-6 text-center py-4">
                    <div class="w-16 h-16 border-4 border-yellow-500/20 border-t-yellow-500 rounded-full animate-spin mx-auto">
                    </div>
                    <div>
                      <p class="text-lg font-semibold">Waiting for Confirmation</p>
                      <p class="text-sm text-slate-400 mt-1">
                        An STK Push has been sent to <strong><%= @mpesa_phone %></strong>
                      </p>
                    </div>
                    <button
                      phx-click="close_mpesa_modal"
                      class="px-6 py-2 bg-white/5 hover:bg-white/10 rounded-xl text-sm font-medium transition-all"
                    >
                      Cancel
                    </button>
                  </div>
                <% else %>
                  <%= if @mpesa_result && @mpesa_result.status == :failed do %>
                    <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4 mb-6">
                      <p class="text-sm text-red-400 text-center font-medium">
                        STK Push failed or timed out. Please try again.
                      </p>
                    </div>
                  <% end %>

                  <form phx-submit="submit_mpesa" class="space-y-6">
                    <div>
                      <label class="text-sm text-slate-400 block mb-2 font-medium">
                        Customer Phone Number
                      </label>
                      <input
                        name="mpesa[phone]"
                        type="tel"
                        required
                        placeholder="07XXXXXXXX"
                        class="w-full bg-slate-900 border border-white/10 rounded-xl py-3 px-4 text-white text-lg focus:ring-2 focus:ring-yellow-500/50 outline-none"
                      />
                    </div>
                    <div class="flex items-center gap-3 justify-end">
                      <button
                        type="button"
                        phx-click="close_mpesa_modal"
                        class="px-6 py-3 bg-white/5 hover:bg-white/10 rounded-xl text-sm font-semibold transition-all"
                      >
                        Cancel
                      </button>
                      <button
                        type="submit"
                        class="px-8 py-3 bg-yellow-500 hover:bg-yellow-400 text-black rounded-xl font-bold shadow-lg shadow-yellow-500/20 transition-all"
                      >
                        Send STK Push
                      </button>
                    </div>
                  </form>
                <% end %>
              </div>
            </div>
          <% end %>

          <%= if @card_modal_open do %>
            <div class="fixed inset-0 z-[60] flex items-center justify-center">
              <div
                phx-click="close_card_modal"
                class="absolute inset-0 bg-black/60 backdrop-blur-sm"
              >
              </div>

              <div class="relative bg-[#0B0F1A] p-8 rounded-2xl w-full max-w-md border border-white/10 shadow-2xl">
                <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
                  <.icon name="hero-credit-card" class="w-6 h-6 text-blue-500" /> Card Payment
                </h3>

                <%= if @card_pending do %>
                  <div class="space-y-6 text-center py-4">
                    <div class="w-16 h-16 border-4 border-blue-500/20 border-t-blue-500 rounded-full animate-spin mx-auto">
                    </div>
                    <div>
                      <p class="text-lg font-semibold">Processing Card</p>
                      <p class="text-sm text-slate-400 mt-1">Contacting payment gateway…</p>
                    </div>
                    <button
                      phx-click="close_card_modal"
                      class="px-6 py-2 bg-white/5 hover:bg-white/10 rounded-xl text-sm font-medium transition-all"
                    >
                      Cancel
                    </button>
                  </div>
                <% else %>
                  <%= if @card_result && @card_result.status == :failed do %>
                    <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4 mb-6">
                      <p class="text-sm text-red-400 text-center font-medium">
                        Transaction declined. Please check details or try another card.
                      </p>
                    </div>
                  <% end %>

                  <form phx-submit="submit_card" class="space-y-6">
                    <div>
                      <label class="text-sm text-slate-400 block mb-2 font-medium">
                        Card Number
                      </label>
                      <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                          <.icon name="hero-credit-card" class="w-5 h-5 text-slate-600" />
                        </div>
                        <input
                          name="card[number]"
                          type="text"
                          required
                          placeholder="4242 4242 4242 4242"
                          class="w-full bg-slate-900 border border-white/10 rounded-xl py-3 pl-12 pr-4 text-white font-mono focus:ring-2 focus:ring-blue-500/50 outline-none"
                        />
                      </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                      <div>
                        <label class="text-sm text-slate-400 block mb-2 font-medium">
                          Expiry (MM/YY)
                        </label>
                        <input
                          name="card[expiry]"
                          type="text"
                          required
                          placeholder="12/26"
                          class="w-full bg-slate-900 border border-white/10 rounded-xl py-3 px-4 text-white font-mono focus:ring-2 focus:ring-blue-500/50 outline-none"
                        />
                      </div>
                      <div>
                        <label class="text-sm text-slate-400 block mb-2 font-medium">CVV</label>
                        <input
                          name="card[cvv]"
                          type="text"
                          required
                          placeholder="123"
                          class="w-full bg-slate-900 border border-white/10 rounded-xl py-3 px-4 text-white font-mono focus:ring-2 focus:ring-blue-500/50 outline-none"
                        />
                      </div>
                    </div>
                    <div>
                      <label class="text-sm text-slate-400 block mb-2 font-medium">
                        Cardholder Name
                      </label>
                      <input
                        name="card[name]"
                        type="text"
                        required
                        placeholder="Jane Mwangi"
                        class="w-full bg-slate-900 border border-white/10 rounded-xl py-3 px-4 text-white focus:ring-2 focus:ring-blue-500/50 outline-none"
                      />
                    </div>
                    <div class="flex items-center gap-3 justify-end pt-4">
                      <button
                        type="button"
                        phx-click="close_card_modal"
                        class="px-6 py-3 bg-white/5 hover:bg-white/10 rounded-xl text-sm font-semibold transition-all"
                      >
                        Cancel
                      </button>
                      <button
                        type="submit"
                        class="px-8 py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-xl font-bold shadow-lg shadow-blue-500/20 transition-all"
                      >
                        Process Payment
                      </button>
                    </div>
                  </form>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Toggle delivery fields based on delivery type selection
    document.addEventListener('DOMContentLoaded', function() {
      const deliveryRadios = document.querySelectorAll('input[name^="shop_delivery"][name$="[delivery_type]"]');

      deliveryRadios.forEach(radio => {
        radio.addEventListener('change', function(e) {
          const shopId = e.target.name.match(/shop_delivery\[(.*?)\]/)[1];
          const deliveryFields = document.querySelector(`.delivery-fields[data-shop-id="${shopId}"]`);

          if (deliveryFields) {
            if (e.target.value === 'pickup') {
              deliveryFields.style.display = 'none';
            } else {
              deliveryFields.style.display = 'block';
            }
          }
        });
      });

      // Initialize: hide delivery fields for pickup selections
      deliveryRadios.forEach(radio => {
        if (radio.checked && radio.value === 'pickup') {
          const shopId = radio.name.match(/shop_delivery\[(.*?)\]/)[1];
          const deliveryFields = document.querySelector(`.delivery-fields[data-shop-id="${shopId}"]`);
          if (deliveryFields) {
            deliveryFields.style.display = 'none';
          }
        }
      });
    });
  </script>
</div>


