<.header>
  <%= @job_post.title %>
  <:subtitle>
    <%= if @job_post.shop do %>
      <%= @job_post.shop.name %>
    <% else %>
      Shop
    <% end %>
  </:subtitle>
  <:actions>
    <.back navigate={~p"/jobs"}>Back to Job Board</.back>
  </:actions>
</.header>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <!-- Job Header -->
    <div class="p-6 border-b border-slate-200">
      <div class="flex items-start justify-between">
        <div>
          <h1 class="text-2xl font-bold text-slate-900 mb-2"><%= @job_post.title %></h1>
          <div class="flex items-center gap-4 text-sm text-slate-500">
            <span>
              <%= if @job_post.shop do %>
                <%= @job_post.shop.name %>
              <% else %>
                Shop
              <% end %>
            </span>
            <span>•</span>
            <span>Posted <%= Calendar.strftime(@job_post.inserted_at, "%B %d, %Y") %></span>
          </div>
        </div>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
          Active
        </span>
      </div>
    </div>
    <!-- Job Details -->
    <div class="p-6 space-y-6">
      <div>
        <h2 class="text-lg font-semibold text-slate-900 mb-3">Job Description</h2>
        <div class="prose prose-slate max-w-none text-slate-600">
          <p><%= @job_post.description %></p>
        </div>
      </div>

      <div>
        <h2 class="text-lg font-semibold text-slate-900 mb-3">Requirements</h2>
        <div class="prose prose-slate max-w-none text-slate-600">
          <p><%= @job_post.requirements %></p>
        </div>
      </div>
      <!-- Apply Button -->
      <div class="pt-4 border-t border-slate-200">
        <.link
          navigate={
            ~p"/shop/#{if @job_post.shop, do: @job_post.shop.slug, else: ""}/rider/register"
          }
          class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-xl text-white bg-violet-600 hover:bg-violet-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-violet-500 transition-colors"
        >
          Apply for this Position
        </.link>
      </div>
    </div>
  </div>
</div>
