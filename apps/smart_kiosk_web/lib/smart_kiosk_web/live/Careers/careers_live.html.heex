<.header>
  Manage Job Posts
  <:subtitle>Create, publish, and retire shop roles from one place.</:subtitle>
  <:actions>
    <%= if @current_shop do %>
      <.link
        patch={~p"/careers/new"}
        class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-violet-600 hover:bg-violet-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-violet-500"
      >
        <.icon name="hero-plus" class="w-4 h-4 mr-2" /> Add Job Post
      </.link>
    <% end %>
  </:actions>
</.header>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <%= if @current_shop do %>
    <%= if @job_posts == [] do %>
      <div class="rounded-3xl border border-dashed border-slate-200 bg-white p-12 text-center shadow-sm">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-violet-50">
          <.icon name="hero-briefcase" class="h-7 w-7 text-violet-600" />
        </div>
        <div class="text-slate-900 text-xl font-semibold mb-2">No job postings yet</div>
        <p class="text-slate-500 mb-6 max-w-md mx-auto">
          Create a post for your shop and it will appear here immediately after you submit it.
        </p>
        <.link
          patch={~p"/careers/new"}
          class="inline-flex items-center gap-2 px-4 py-2 border border-transparent text-sm font-medium rounded-xl text-white bg-violet-600 hover:bg-violet-700 shadow-sm shadow-violet-600/20 transition-all"
        >
          <.icon name="hero-plus" class="h-4 w-4" />
          Create your first job post
        </.link>
      </div>
    <% else %>
      <div class="grid gap-4">
        <%= for job_post <- @job_posts do %>
          <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
              <div class="flex-1">
                <div class="mb-3 flex items-center gap-3">
                  <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-violet-50">
                    <.icon name="hero-briefcase" class="h-5 w-5 text-violet-600" />
                  </div>
                  <div>
                    <h3 class="text-lg font-semibold text-slate-900 leading-tight"><%= job_post.title %></h3>
                    <p class="text-xs uppercase tracking-wider text-slate-400">Job post</p>
                  </div>
                </div>
                <p class="text-sm text-slate-600 line-clamp-2 mb-4 max-w-3xl"><%= job_post.description %></p>
                <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
                  <span class="rounded-full bg-slate-100 px-3 py-1">
                    Posted <%= Calendar.strftime(job_post.inserted_at, "%B %d, %Y") %>
                  </span>
                  <span class={[
                    "inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold",
                    job_post.status == "active" && "bg-emerald-50 text-emerald-700",
                    job_post.status == "overdue" && "bg-amber-50 text-amber-700",
                    job_post.status not in ["active", "overdue"] && "bg-slate-100 text-slate-700"
                  ]}>
                    <%= job_post.status %>
                  </span>
                </div>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <.link
                  navigate={~p"/jobs/#{job_post.id}/edit"}
                  class="inline-flex items-center gap-2 px-3 py-2 border border-slate-200 text-sm font-medium rounded-xl text-slate-700 bg-white hover:bg-slate-50 transition-colors"
                >
                  <.icon name="hero-pencil-square" class="h-4 w-4" />
                  Edit
                </.link>
                <button
                  phx-click="toggle_status"
                  phx-value-id={job_post.id}
                  class="inline-flex items-center gap-2 px-3 py-2 border border-amber-200 text-sm font-medium rounded-xl text-amber-700 bg-white hover:bg-amber-50 transition-colors"
                >
                  <.icon name="hero-arrow-path" class="h-4 w-4" />
                  <%= if job_post.status == "active", do: "Mark Overdue", else: "Mark Active" %>
                </button>
                <button
                  phx-click="delete"
                  phx-value-id={job_post.id}
                  class="inline-flex items-center gap-2 px-3 py-2 border border-red-200 text-sm font-medium rounded-xl text-red-700 bg-white hover:bg-red-50 transition-colors"
                  data-confirm="Are you sure you want to delete this job post?"
                >
                  <.icon name="hero-trash" class="h-4 w-4" />
                  Delete
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="rounded-3xl border border-slate-200 bg-white p-12 text-center shadow-sm">
      <div class="text-slate-900 text-xl font-semibold">You need to be logged in as a shop owner to manage job posts</div>
      <p class="text-slate-500 mt-2">Sign in with a shop account to create and manage your roles.</p>
      <%= if @current_user do %>
        <.link
          navigate={~p"/create-shop"}
          class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-xl text-white bg-violet-600 hover:bg-violet-700 mt-4"
        >
          Create a Shop
        </.link>
      <% end %>
    </div>
  <% end %>
</div>

<%= if @live_action == :new do %>
  <.modal id="job-post-modal" show on_cancel={JS.patch(~p"/careers")}>
    <div class="p-1">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-slate-900">Create Job Post</h2>
        <p class="text-sm text-slate-500 mt-1">Publish a new role for your shop without leaving this page.</p>
      </div>

      <.form for={@form} id="job-post-form" phx-change="validate" phx-submit="save" class="space-y-5">
        <.input field={@form[:title]} type="text" label="Job Title" placeholder="e.g., Delivery Rider" />
        <.input
          field={@form[:description]}
          type="textarea"
          label="Description"
          placeholder="Describe the role and responsibilities..."
          rows="4"
        />
        <.input
          field={@form[:requirements]}
          type="textarea"
          label="Requirements"
          placeholder="List the requirements for this position..."
          rows="4"
        />
        <.input
          field={@form[:status]}
          type="select"
          label="Status"
          options={[{"Active", "active"}, {"Overdue", "overdue"}]}
        />

        <div class="flex items-center justify-end gap-3 pt-2">
          <.link patch={~p"/careers"} class="px-4 py-2 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-50">
            Cancel
          </.link>
          <button type="submit" class="px-4 py-2 rounded-xl bg-violet-600 text-white font-semibold hover:bg-violet-700">
            Create Job Post
          </button>
        </div>
      </.form>
    </div>
  </.modal>
<% end %>
