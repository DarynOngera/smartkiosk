<div class="min-h-screen bg-[#0B0F1A]">
  <Layouts.app
    flash={@flash}
    current_path="/users/settings"
    current_user={@current_user}
    cart_count={@cart_count}
  >
    <div class="max-w-4xl mx-auto p-6 lg:p-10">
      <header class="mb-8">
        <h1 class="text-3xl font-bold text-white tracking-tight">Account Settings</h1>
        <p class="text-slate-500 mt-2">Manage your profile, email, and security settings.</p>
      </header>

      <div class="flex flex-col lg:flex-row gap-8">
        <nav class="lg:w-56 shrink-0">
          <ul class="flex lg:flex-col gap-1 overflow-x-auto lg:overflow-visible pb-2 lg:pb-0">
            <li>
              <.link
                patch={~p"/users/settings?tab=profile"}
                class={[
                  "flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all whitespace-nowrap",
                  if(@tab == "profile",
                    do: "bg-violet-500/20 text-violet-300 border border-violet-500/30",
                    else: "text-slate-400 hover:text-white hover:bg-white/5"
                  )
                ]}
              >
                <.icon name="hero-user" class="w-4 h-4" /> Profile
              </.link>
            </li>
            <li>
              <.link
                patch={~p"/users/settings?tab=email"}
                class={[
                  "flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all whitespace-nowrap",
                  if(@tab == "email",
                    do: "bg-violet-500/20 text-violet-300 border border-violet-500/30",
                    else: "text-slate-400 hover:text-white hover:bg-white/5"
                  )
                ]}
              >
                <.icon name="hero-at-symbol" class="w-4 h-4" /> Email
              </.link>
            </li>
            <li>
              <.link
                patch={~p"/users/settings?tab=password"}
                class={[
                  "flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all whitespace-nowrap",
                  if(@tab == "password",
                    do: "bg-violet-500/20 text-violet-300 border border-violet-500/30",
                    else: "text-slate-400 hover:text-white hover:bg-white/5"
                  )
                ]}
              >
                <.icon name="hero-lock-closed" class="w-4 h-4" /> Password
              </.link>
            </li>
          </ul>
        </nav>

        <div class="flex-1 min-w-0">
          <%= cond do %>
            <% @tab == "profile" -> %>
              <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
                <h2 class="text-lg font-semibold text-white mb-6">Profile Information</h2>
                <.form
                  for={@profile_form}
                  id="profile-form"
                  phx-change="validate_profile"
                  phx-submit="save_profile"
                >
                  <div class="space-y-5">
                    <div>
                      <span class="label mb-1">Profile Picture</span>
                      <div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                        <div class="h-16 w-16 shrink-0 overflow-hidden rounded-full bg-white/5 border border-white/10 flex items-center justify-center">
                          <%= if @current_user.avatar_url do %>
                            <img
                              src={@current_user.avatar_url}
                              alt={@current_user.full_name || @current_user.email}
                              class="h-full w-full object-cover"
                            />
                          <% else %>
                            <.icon name="hero-user" class="h-7 w-7 text-slate-500" />
                          <% end %>
                        </div>

                        <div class="min-w-0 flex-1">
                          <.live_file_input
                            upload={@uploads.avatar}
                            class="block w-full text-sm text-slate-300 file:mr-4 file:rounded-lg file:border-0 file:bg-violet-600 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-white hover:file:bg-violet-500"
                          />
                          <p class="mt-2 text-xs text-slate-500">JPG, PNG, or WebP. Max 5MB.</p>
                          <p
                            :for={error <- upload_errors(@uploads.avatar)}
                            class="mt-2 text-sm text-red-400"
                          >
                            <%= Phoenix.Naming.humanize(error) %>
                          </p>
                        </div>
                      </div>
                    </div>

                    <div>
                      <span class="label mb-1">Full Name</span>
                      <.input
                        field={@profile_form[:full_name]}
                        type="text"
                        placeholder="Your full name"
                      />
                    </div>
                    <div>
                      <span class="label mb-1">Phone Number</span>
                      <.input
                        field={@profile_form[:phone]}
                        type="text"
                        placeholder="+254 700 000 000"
                      />
                    </div>
                  </div>
                  <div class="mt-6 flex justify-end">
                    <button
                      type="submit"
                      class="px-6 py-2.5 bg-violet-500 hover:bg-violet-400 text-white rounded-xl font-semibold transition-all"
                    >
                      Save Changes
                    </button>
                  </div>
                </.form>
              </div>
            <% @tab == "email" -> %>
              <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
                <h2 class="text-lg font-semibold text-white mb-6">Email Address</h2>
                <p class="text-slate-400 text-sm mb-6">
                  Change your email address. You'll need to confirm your new email to complete the change.
                </p>
                <.form
                  for={@email_form}
                  id="email-form"
                  phx-change="validate_email"
                  phx-submit="save_email"
                >
                  <div class="space-y-5">
                    <div>
                      <span class="label mb-1">New Email Address</span>
                      <.input
                        field={@email_form[:email]}
                        type="email"
                        placeholder="you@example.com"
                      />
                    </div>
                    <div>
                      <span class="label mb-1">Current Password</span>
                      <.input
                        field={@email_form[:current_password]}
                        type="password"
                        placeholder="Enter your current password to confirm"
                      />
                    </div>
                  </div>
                  <div class="mt-6 flex justify-end">
                    <button
                      type="submit"
                      class="px-6 py-2.5 bg-violet-500 hover:bg-violet-400 text-white rounded-xl font-semibold transition-all"
                    >
                      Update Email
                    </button>
                  </div>
                </.form>
              </div>
            <% @tab == "password" -> %>
              <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
                <h2 class="text-lg font-semibold text-white mb-6">Change Password</h2>
                <.form
                  for={@password_form}
                  id="password-form"
                  phx-change="validate_password"
                  phx-submit="save_password"
                >
                  <div class="space-y-5">
                    <div>
                      <span class="label mb-1">New Password</span>
                      <.input
                        field={@password_form[:password]}
                        type="password"
                        placeholder="At least 12 characters"
                      />
                    </div>
                    <div>
                      <span class="label mb-1">Confirm New Password</span>
                      <.input
                        field={@password_form[:password_confirmation]}
                        type="password"
                        placeholder="Repeat your new password"
                      />
                    </div>
                    <div>
                      <span class="label mb-1">Current Password</span>
                      <.input
                        field={@password_form[:current_password]}
                        type="password"
                        placeholder="Enter your current password to confirm"
                      />
                    </div>
                  </div>
                  <div class="mt-6 flex justify-end">
                    <button
                      type="submit"
                      class="px-6 py-2.5 bg-violet-500 hover:bg-violet-400 text-white rounded-xl font-semibold transition-all"
                    >
                      Update Password
                    </button>
                  </div>
                </.form>
              </div>
          <% end %>
        </div>
      </div>
    </div>
  </Layouts.app>
</div>
